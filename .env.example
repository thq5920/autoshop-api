# AutoShop API 默认环境变量示例（生产/开发）
# 复制到 .env 后按需修改；切到测试环境请用 .env.test.example。

# 环境：dev / prod / test
# 测试请显式使用 .env.test.example。
AUTOSHOP_ENV=dev
AUTOSHOP_DEBUG=true

# 测试接口 /api/v1/_test/reset 守门：
#   启用条件：AUTOSHOP_ENV=test 且 AUTOSHOP_ENABLE_TEST_API=true
#   生产默认关闭。
AUTOSHOP_ENABLE_TEST_API=false

SECRET_KEY=please-change-this-to-a-random-32-char-string

# MySQL 连接
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=autoshop
MYSQL_PASSWORD=autoshop
MYSQL_DB=autoshop
MYSQL_CHARSET=utf8mb4

BCRYPT_ROUNDS=12

# 是否对外暴露登录失败的具体原因（账号不存在 / 密码错误）
AUTOSHOP_EXPOSE_AUTH_DETAIL=true
