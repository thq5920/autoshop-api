# AutoShop API 测试环境变量示例
# 使用：
#   cp .env.test.example .env
# 或：
#   export AUTOSHOP_ENV=test AUTOSHOP_ENABLE_TEST_API=true
#
# 只有当 AUTOSHOP_ENV=test 与 AUTOSHOP_ENABLE_TEST_API=true 两个条件
# 都满足时，/api/v1/_test/reset 才会被注册。

AUTOSHOP_ENV=test
AUTOSHOP_ENABLE_TEST_API=true
AUTOSHOP_DEBUG=true
AUTOSHOP_EXPOSE_AUTH_DETAIL=true

SECRET_KEY=test-secret-key-not-for-production-use

# MySQL 连接
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=autoshop
MYSQL_PASSWORD=autoshop
MYSQL_DB=autoshop
MYSQL_CHARSET=utf8mb4

# 测试环境 bcrypt rounds 调到 4 加速
BCRYPT_ROUNDS=4
